---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';

const posts = (
  await getCollection('releases', ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = new Intl.DateTimeFormat('en-AU', {
  year: 'numeric',
  month: 'short',
});
---

<Base
  title="Releases | Agentic GRC"
  description="Articles and video episodes on building defensible agent systems for risk and compliance work in regulated environments."
  path="/releases/"
>
  <div class="mx-auto max-w-[860px] px-6">
    <section class="mt-16">
      <p class="promptline">
        <span class="p">$</span> ls releases/ --sort=date
      </p>
      <h1 class="text-3xl font-semibold tracking-[-0.01em] sm:text-4xl">
        Releases
      </h1>
      <p class="mt-3 max-w-[62ch] text-dim">
        Articles and video episodes. Working systems, stated limitations, no
        slideware.
      </p>

      <ul class="mt-12">
        {
          posts.map((post) => (
            <li class="mb-4">
              <a
                href={`/releases/${post.id}/`}
                class="group block rounded-lg border border-line bg-panel px-6 py-5 no-underline transition-colors hover:border-faint"
              >
                <p class="mb-2 font-mono text-[11.5px] tracking-[0.14em] text-dim">
                  {fmt.format(post.data.date).toUpperCase()}
                  <span class="text-teal">
                    {' '}
                    &middot; {post.data.kind === 'video' ? 'VIDEO' : 'ARTICLE'}
                  </span>
                </p>
                <h2 class="text-xl font-semibold text-txt group-hover:text-teal sm:text-[22px]">
                  {post.data.title}
                </h2>
                <p class="mt-1.5 text-[15.5px] leading-relaxed text-dim">
                  {post.data.description}
                </p>
              </a>
            </li>
          ))
        }
      </ul>

      {
        posts.length === 0 && (
          <p class="mt-8 font-mono text-sm text-dim">
            <span class="text-faint">&#8990;</span> 0 entries. The manifesto is
            the founding document; the record starts soon.
          </p>
        )
      }
    </section>
  </div>
</Base>
